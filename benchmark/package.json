{
  "name": "ts-cli",
  "version": "0.0.0",
  "description": "Benchmarking tool for Typesense",
  "packageManager": "bun@1.3.10",
  "type": "module",
  "main": "index.js",
  "bin": {
    "typesense-benchmark": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest",
    "format": "prettier --write \"**/*.{ts, md}\""
  },
  "keywords": [
    "full-text search",
    "search engine",
    "typesense",
    "benchmark"
  ],
  "author": {
    "name": "Typesense, Inc.",
    "email": "contact@typesense.org",
    "url": "https://typesense.org"
  },
  "contributors": [
    {
      "name": "Fanis Tharropoulos",
      "email": "fanis@typesense.org",
      "url": "https://github.com/tharropoulos"
    }
  ],
  "license": "GPL",
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@faker-js/faker": "^9.9.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/command-line-args": "^5.2.3",
    "@types/command-line-usage": "^5.0.4",
    "@types/fs-extra": "^11.0.4",
    "@types/gunzip-maybe": "^1.4.3",
    "@types/k6": "^0.54.2",
    "@types/node": "^22.19.15",
    "@types/tar-stream": "^3.1.4",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.3",
    "openai": "^4.104.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "type-fest": "^4.41.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.4",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.10",
    "@types/asciichart": "^1.5.8",
    "asciichart": "^1.5.25",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "cosmiconfig": "^9.0.1",
    "docker-compose": "^1.3.1",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.4",
    "gunzip-maybe": "^1.4.2",
    "influx": "^5.12.0",
    "inquirer": "^12.11.1",
    "k6": "^0.0.0",
    "neverthrow": "^8.2.0",
    "ora": "^8.2.0",
    "strip-ansi": "^7.2.0",
    "table": "^6.9.0",
    "tar-stream": "^3.1.8",
    "typesense": "2.1.0-6"
  }
}
