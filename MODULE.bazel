    strip_prefix = "s2geometry-0.12.0",
    urls = ["https://github.com/google/s2geometry/archive/refs/tags/v0.12.0.tar.gz"],
    patch_cmds = [
        "find . -mindepth 2 \\( -name BUILD -o -name BUILD.bazel \\) -delete",
        "perl -0777 -i -pe 's/absl::Nonnull<([^>]+)>/$1/g' src/s2/s2edge_tessellator.h src/s2/s2density_tree.h src/s2/s2density_tree.cc",
