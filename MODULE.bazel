new_git_repository(
    name = "onnx_runtime_extensions",
    build_file = "//bazel:onnxruntime_extensions.BUILD",
    commit = "1f9d7ee0c80b4f94946ee5650cb242aa01dd6278",
    remote = "https://github.com/microsoft/onnxruntime-extensions",
    patches = ["//bazel:onnx_ext.patch"],
    patch_args = ["-p1"],
    patch_cmds = [
        "sed -i '/#include \"string_tensor.h\"/d' operators/tokenizer/basic_tokenizer.cc",
        "sed -i '84,$ d' operators/tokenizer/basic_tokenizer.cc",
        "sed -i '307,$ d' operators/tokenizer/bert_tokenizer.cc",
        "sed -i '1 a\\#include \"string_utils.h\"' operators/tokenizer/bert_tokenizer.cc",
        """cat > base/ortx_stubs.h << 'STUBEOF'
#pragma once
#include <stdexcept>
#include <string>
#ifndef ORT_RUNTIME_EXCEPTION
#define ORT_RUNTIME_EXCEPTION 1
#endif
#ifndef ORTX_CXX_API_THROW
#define ORTX_CXX_API_THROW(msg, code) throw std::runtime_error(std::to_string(code) + ": " + std::string(msg))
#endif
STUBEOF""",
        "sed -i '1 a\\#include \"ortx_stubs.h\"' operators/tokenizer/bert_tokenizer.cc",
        "sed -i '/#include \"ort_c_to_cpp.h\"/d' base/string_utils.h",
        "sed -i '/OrtTensorDimensions/,+2d' base/string_utils.h",
        "sed -i '/^template <>$/{N;/^template <>\\n$/d}' base/string_utils.h",
        "sed -i '/#include <string_view>/a\\#include <string>' base/ustring.h",
        "sed -i '/#include <string>/a\\#include <cstddef>' base/ustring.h",
    ],
)

