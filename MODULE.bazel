        """cat > absl_stubs.cmake << 'STUBEOF'
include_directories(SYSTEM ${ABSL_INCLUDE_DIR})
set(_S2_ABSL_STUBS base btree check config core_headers dynamic_annotations endian
    fixed_array flags flags_reflection flat_hash_map flat_hash_set hash
    inlined_vector int128 log log_severity memory random_random span status
    str_format strings synchronization type_traits utility vlog_is_on)
foreach(_n ${_S2_ABSL_STUBS})
    if(NOT TARGET absl::${_n})
        add_library(absl::${_n} INTERFACE IMPORTED)
    endif()
endforeach()
STUBEOF""",
        "perl -0777 -i -pe 's/find_package\\(absl REQUIRED\\)/include(absl_stubs.cmake)/g' CMakeLists.txt",
    ],
)

