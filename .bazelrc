# Full Bzlmod mode (Bazel 8+ and Bazel 9 compatible)
# WORKSPACE is intentionally not used for external dependency resolution.

build --incompatible_strict_action_env
build --workspace_status_command=./bazel/workspace_status.sh
build --action_env=BAZEL_CXXOPTS="-std=gnu++20"
build --define=TYPESENSE_VERSION=\"nightly\"
build --cxxopt="-std=gnu++20"
build --cxxopt="-include" --cxxopt="cstdint"
# Scope deprecation/diagnostic-noise suppression to third-party Protobuf sources only.
build --per_file_copt=external/protobuf\+.*@-Wno-deprecated-declarations
build --per_file_copt=external/protobuf\+.*/map\.cc@-Wno-deprecated
build --per_file_copt=external/protobuf\+.*@-Wno-sign-compare
build --host_per_file_copt=external/protobuf\+.*@-Wno-deprecated-declarations
build --host_per_file_copt=external/protobuf\+.*/map\.cc@-Wno-deprecated
build --host_per_file_copt=external/protobuf\+.*@-Wno-sign-compare
# GCC-only protobuf false positives must not leak into clang guardrails.
build:gcc --per_file_copt=external/protobuf\+.*@-Wno-maybe-uninitialized
build:gcc --host_per_file_copt=external/protobuf\+.*@-Wno-maybe-uninitialized
# GCC on aarch64 can emit non-actionable psABI notes from third-party headers
# under modern C++ modes; keep them out of routine CI/release logs.
build:gcc --cxxopt=-Wno-psabi
build:gcc --host_cxxopt=-Wno-psabi
build:macos --per_file_copt=external/protobuf\+.*/map\.cc@-Wno-deprecated-this-capture
build:macos --host_per_file_copt=external/protobuf\+.*/map\.cc@-Wno-deprecated-this-capture
# Scope heavy third-party warning buckets to their dependency boundaries.
build --per_file_copt=external/\+new_git_repository\+lrucache/.*@-Wno-deprecated-declarations
build --per_file_copt=external/\+new_git_repository\+onnx_runtime_extensions/.*@-Wno-pessimizing-move
build --per_file_copt=.*clip_tokenizer.*@-Wno-pessimizing-move
build --per_file_copt=.*clip_tokenizer.*@-Wno-sign-compare
build --per_file_copt=.*clip_tokenizer.*@-Wno-unused-variable
build --per_file_copt=.*quicly.*@-Wno-unused-but-set-variable
# USearch emits non-actionable half-precision #warnings from index_plugins.hpp
# even though the fork's production vector path is float32-only.
build --per_file_copt=(src/vector_index|src/main/usearch_vector_backend_benchmark|test/usearch_vector_backend_prototype_test)\.cpp@-Wno-cpp
# GCC 15 defaults C to gnu23; pin C dialect until third-party C deps are C23-clean.
build --conlyopt="-std=gnu17"
build:linux --conlyopt="-D_GNU_SOURCE"
build --strip=never
build --jobs=6

test --jobs=6

run --jobs=6

build --enable_platform_specific_config

# --- Sanitizer configs ---
# --copt applies to all cc_library targets (including external deps like abseil/protobuf).
# Foreign_cc targets (kakasi, iconv, etc.) must override CFLAGS in their BUILD files
# to strip sanitizer flags, since configure scripts break under instrumentation.
build:sanitizer --strip=never
build:sanitizer --copt -fno-omit-frame-pointer

build:asan --config=sanitizer
build:asan --define=mode=asan
build:asan --copt -fsanitize=address
build:asan --linkopt -fsanitize=address
build:asan --copt -DASAN_BUILD
build:asan --copt -DNO_JEMALLOC
build:asan --copt -DADDRESS_SANITIZER=1
# GCC 14/libstdc++ can emit std::regex false positives under ASAN in a narrow set
# of regex-heavy first-party translation units and the external clip tokenizer.
build:asan --per_file_copt=src/(auth_manager|collection|collection_manager|conversation_model|core_api|field|filter|http_server|join|natural_language_search_model)\.cpp@-Wno-maybe-uninitialized
build:asan --per_file_copt=.*clip_tokenizer.*@-Wno-maybe-uninitialized
build:asan --test_env=ASAN_OPTIONS=detect_leaks=1:detect_odr_violation=0:color=always
build:asan --test_env=LSAN_OPTIONS=suppressions=test/lsan_suppressions.txt
build:asan --test_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1

build:tsan --config=sanitizer
build:tsan --define=mode=tsan
build:tsan --copt -fsanitize=thread
build:tsan --linkopt -fsanitize=thread
build:tsan --copt -DTSAN_BUILD
build:tsan --copt -DNO_JEMALLOC
# GCC warns on Abseil's atomic_thread_fence under TSAN even though the code is in
# external Abseil and not actionable inside this repo.
build:tsan --per_file_copt=external/abseil-cpp\+.*@-Wno-tsan
build:tsan --test_env=TSAN_OPTIONS=halt_on_error=1:second_deadlock_stack=1:history_size=4:suppressions=test/tsan_suppressions.txt

# Static linking of libstdc++/libgcc is handled by linkopts in BUILD file
# BAZEL_LINKLIBS removed: Bazel 7+ treats the value as a single token (not split on spaces)
