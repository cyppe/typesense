Fix macro redefinition warnings from dynamic_annotations.h

brpc's bundled dynamic_annotations.h unconditionally defines several
ANNOTATE_* macros that Abseil's dynamic_annotations.h also defines.
Wrap them in #ifndef guards to avoid -Wmacro-redefined when both
headers are transitively included.

Also migrate cc_proto_library load from @rules_cc (deprecated) to
@com_google_protobuf//bazel:cc_proto_library.bzl.

diff --git a/BUILD.bazel b/BUILD.bazel
index 138e416..8c99b75 100644
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -14,7 +14,8 @@
 # limitations under the License.

 load("@rules_proto//proto:defs.bzl", "proto_library")
-load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_proto_library", "objc_library")
+load("@com_google_protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
+load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "objc_library")

 licenses(["notice"])  # Apache v2

diff --git a/src/butil/third_party/dynamic_annotations/dynamic_annotations.h b/src/butil/third_party/dynamic_annotations/dynamic_annotations.h
index 7b3ae95..fe690b3 100644
--- a/src/butil/third_party/dynamic_annotations/dynamic_annotations.h
+++ b/src/butil/third_party/dynamic_annotations/dynamic_annotations.h
@@ -409,12 +409,20 @@
   #define ANNOTATE_MUTEX_IS_USED_AS_CONDVAR(mu) /* empty */
   #define ANNOTATE_TRACE_MEMORY(arg) /* empty */
   #define ANNOTATE_THREAD_NAME(name) /* empty */
-  #define ANNOTATE_IGNORE_READS_BEGIN() /* empty */
-  #define ANNOTATE_IGNORE_READS_END() /* empty */
+  #ifndef ANNOTATE_IGNORE_READS_BEGIN
+#define ANNOTATE_IGNORE_READS_BEGIN() /* empty */
+#endif
+  #ifndef ANNOTATE_IGNORE_READS_END
+#define ANNOTATE_IGNORE_READS_END() /* empty */
+#endif
   #define ANNOTATE_IGNORE_WRITES_BEGIN() /* empty */
   #define ANNOTATE_IGNORE_WRITES_END() /* empty */
-  #define ANNOTATE_IGNORE_READS_AND_WRITES_BEGIN() /* empty */
-  #define ANNOTATE_IGNORE_READS_AND_WRITES_END() /* empty */
+  #ifndef ANNOTATE_IGNORE_READS_AND_WRITES_BEGIN
+#define ANNOTATE_IGNORE_READS_AND_WRITES_BEGIN() /* empty */
+#endif
+  #ifndef ANNOTATE_IGNORE_READS_AND_WRITES_END
+#define ANNOTATE_IGNORE_READS_AND_WRITES_END() /* empty */
+#endif
   #define ANNOTATE_IGNORE_SYNC_BEGIN() /* empty */
   #define ANNOTATE_IGNORE_SYNC_END() /* empty */
   #define ANNOTATE_ENABLE_RACE_DETECTION(enable) /* empty */
@@ -587,7 +595,9 @@ int RunningOnValgrind(void) DYNAMIC_ANNOTATIONS_ATTRIBUTE_WEAK;
     }
 #else /* DYNAMIC_ANNOTATIONS_ENABLED == 0 */

-  #define ANNOTATE_UNPROTECTED_READ(x) (x)
+  #ifndef ANNOTATE_UNPROTECTED_READ
+#define ANNOTATE_UNPROTECTED_READ(x) (x)
+#endif
   #define ANNOTATE_BENIGN_RACE_STATIC(static_var, description)  /* empty */

 #endif /* DYNAMIC_ANNOTATIONS_ENABLED */
